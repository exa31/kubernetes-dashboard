# Dockerfile for running migrations
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Cache module downloads
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build migration tool statically
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o migrate cmd/migrate.go

# Final stage
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy migration tool and SQL migrations
COPY --from=builder /app/migrate .
COPY --from=builder /app/migrations ./migrations

ENTRYPOINT ["./migrate"]
CMD ["-action=up"]
